@model GerenciadorFilmes.ViewModels.EditarFilmeViewModel

@{
    ViewData["Title"] = "Editar Projeto";
}

<h1>Editar Filme</h1>

<form asp-action="Editar" method="post">

    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <partial name="_FormularioFilmes"
             model="(GerenciadorFilmes.ViewModels.FilmeFormularioViewModel)Model" />

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">
            Salvar alterações
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}