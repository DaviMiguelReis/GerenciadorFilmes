@model GerenciadorFilmes.ViewModels.FilmesIndexViewModels

@{
    ViewData["Title"] = "Filmes Acadêmicos";
}

<div class="page-heading">
    <div>
        <h1>Filmes Acadêmicos</h1>
        <p>Gerencie os filmes cadastrados.</p>
    </div>

    <a asp-action="Cadastrar" class="button">
        Novo filme
    </a>
</div>



<form asp-action="Index" method="get" class="toolbar">

    <div class="search-bar">

        <input type="text"
               name="pesquisa"
               value="@Model.TextoPesquisa"
               class="input"
               placeholder="Pesquisar por título..." />

        <input type="hidden"
               name="ordenarPor"
               value="@Model.OrdenarPor" />

        <button type="submit" class="button">
            Pesquisar
        </button>

        <a asp-action="Index"
           class="button secondary">
            Limpar
        </a>

    </div>

</form>


<div class="list-meta">

    @if (string.IsNullOrWhiteSpace(Model.TextoPesquisa))
    {
        <p class="counter">
            @Model.QuantidadeTotal filme(s) cadastrado(s)
        </p>
    }
    else
    {
        <p class="counter">
            @Model.QuantidadeTotal resultado(s) para
            "<strong>@Model.TextoPesquisa</strong>"
        </p>
    }

</div>



<p class="sort-links">

    Ordenar por:

    <a asp-action="Index"
       asp-route-pesquisa="@Model.TextoPesquisa"
       asp-route-ordenarPor="titulo"
       class="@(Model.OrdenarPor == "titulo" ? "active" : null)">
        Título
    </a>

    <a asp-action="Index"
       asp-route-pesquisa="@Model.TextoPesquisa"
       asp-route-ordenarPor="Ano Lanaçamento"
       class="@(Model.OrdenarPor == "AnoLancamento" ? "active" : null)">
        Ano
    </a>

</p>


@if (TempData["Mensagem"] is not null)
{
    <div class="alert success">
        @TempData["Mensagem"]
    </div>
}

@if (Model.filmes.Count == 0)
{
    <div class="empty">

        @if (string.IsNullOrWhiteSpace(Model.TextoPesquisa))
        {
            <text>
                Nenhum filme cadastrado.
            </text>
        }
        else
        {
            <text>
                Nenhum filme encontrado para
                "@Model.TextoPesquisa".
            </text>
        }

    </div>
}
else
{
    <table>

        <thead>
            <tr>
                <th>Título</th>
                <th>Gênero</th>
                <th>Ano Lançamento</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var filme in Model.filmes)
            {
                <tr>

                    <td>
                        @filme.Titulo
                    </td>

                    <td>
                        @filme.Genero?.Nome
                    </td>

                    <td>
                        @filme.AnoLancamento 
                    </td>

                    <td class="actions">

                        <a asp-action="Detalhes"
                           asp-route-id="@filme.Id">
                            Detalhes
                        </a>

                        <a asp-action="Editar"
                           asp-route-id="@filme.Id">
                            Editar
                        </a>

                        <a asp-action="Excluir"
                           asp-route-id="@filme.Id"
                           class="danger-link">
                            Excluir
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>
}