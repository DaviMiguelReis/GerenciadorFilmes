@model GerenciadorFilmes.ViewModels.NovoFilmeViewModel

@{
    ViewData["Title"] = "Cadastrar Filmes";
}

<h1>Cadastrar Filmes</h1>

<form asp-action="Cadastrar" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <partial name="_FormularioFilmes"
             model="(GerenciadorFilmes.ViewModels.FilmeFormularioViewModel)Model" />

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">
            Cadastrar
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}